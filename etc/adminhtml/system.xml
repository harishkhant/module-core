<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="reva" translate="label" sortOrder="100" class="reva-tab">
            <label>Reva</label>
        </tab>
        <section id="reva_config" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1"
            showInStore="1">
            <class>reva-separator-top</class>
            <label>Information &amp; Marketplace</label>
            <tab>reva</tab>
            <resource>Reva_Core::information</resource>
            <group id="reva_menu" translate="label" type="text" sortOrder="15" showInDefault="1" showInWebsite="0"
                showInStore="0">
                <label>About RevaMagento</label>
                <field id="information" translate="label" type="label" sortOrder="5" showInDefault="1"
                    showInWebsite="0" showInStore="0">
                    <label>Information</label>
                    <frontend_model>Reva\Core\Block\Adminhtml\System\Config\Information</frontend_model>
                </field>
                <field id="menu_enable" translate="label comment" type="select" sortOrder="25" showInDefault="1"
                    showInWebsite="0" showInStore="0">
                    <label>Enable Reva Menu</label>
                    <comment>Show the MageReva menu in the admin sidebar.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
