                $initials = static function (string $name): string {
                    $words = preg_split('/[^A-Za-z0-9]+/', $name, -1, PREG_SPLIT_NO_EMPTY) ?: ['R'];

                    return strtoupper(substr($words[0], 0, 1) . (isset($words[1]) ? substr($words[1], 0, 1) : ''));
                };
                $names = implode(', ', array_map(
                    static fn (array $extension) => '<strong>' . $escaper->escapeHtml($extension['name']) . '</strong>',
                    array_slice($premiumExtensions, 0, 3)
