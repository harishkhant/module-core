                    . '">' . $escaper->escapeHtml(__('Learn more')) . '</a>';
            };
            $freeItem = function (array $extension) use ($escaper, $learnMore): string {
                return '<li class="reva-info__extension"><div><strong>' . $escaper->escapeHtml($extension['name'])
                    . '</strong><p>' . $escaper->escapeHtml($extension['description']) . '</p></div>'
                    . $learnMore($extension, 'reva-info__badge') . '</li>';
            };
